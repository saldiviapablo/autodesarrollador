{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "allowed_files",
    "tests",
    "criteria",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task": {
      "type": "string",
      "minLength": 5,
      "maxLength": 600
    },
    "backend": {
      "enum": [
        "live",
        "probe"
      ]
    },
    "allowed_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 40
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/command"
      }
    },
    "builds": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/command"
      }
    },
    "linters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/command"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "test_id"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "test_id": {
            "type": "string"
          }
        }
      },
      "maxItems": 16
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "min_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "immutable_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "no_build_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "phase_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 360
    },
    "global_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28800
    },
    "probe_delay_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "max_cycles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "restart_budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "heartbeat_stale_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "url"
          ],
          "not": {
            "required": [
              "query"
            ]
          }
        },
        {
          "required": [
            "query"
          ],
          "not": {
            "required": [
              "url"
            ]
          }
        }
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "domains": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "diagnose_before_fetch": {
          "type": "boolean"
        }
      }
    },
    "consultation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "response_timeout_seconds",
        "after_recovery",
        "new_conversation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,120}$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "response_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "after_recovery": {
          "type": "boolean"
        },
        "new_conversation": {
          "type": "boolean"
        }
      }
    },
    "sandbox_crash_boundary": {
      "type": "boolean"
    },
    "write_scope": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "definitions": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "marker"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "marker": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    }
  }
}
