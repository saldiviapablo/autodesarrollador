{
  "$schema":"http://json-schema.org/draft-07/schema#","type":"object","additionalProperties":false,
  "required":["schema_version","task","allowed_files","tests","criteria","artifacts"],
  "properties":{
    "schema_version":{"const":"1.0"},"task":{"type":"string","minLength":5},
    "backend":{"enum":["live","probe"]},"allowed_files":{"type":"array","minItems":1,"items":{"type":"string"}},
    "tests":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/command"}},
    "builds":{"type":"array","items":{"$ref":"#/definitions/command"}},"linters":{"type":"array","items":{"$ref":"#/definitions/command"}},
    "criteria":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["criterion","test_id"],"properties":{"criterion":{"type":"string"},"test_id":{"type":"string"}}}},
    "artifacts":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path"],"properties":{"path":{"type":"string"},"min_bytes":{"type":"integer","minimum":1}}}},
    "immutable_files":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    "no_build_reason":{"type":"string"},"phase_timeout_seconds":{"type":"integer","minimum":1,"maximum":360},
    "global_timeout_seconds":{"type":"integer","minimum":1,"maximum":28800},"probe_delay_seconds":{"type":"integer","minimum":0,"maximum":30},
    "max_cycles":{"type":"integer","minimum":1,"maximum":20},"restart_budget":{"type":"integer","minimum":0,"maximum":3},
    "heartbeat_stale_seconds":{"type":"integer","minimum":1,"maximum":120}
  },
  "definitions":{"command":{"type":"object","additionalProperties":false,"required":["id","argv","marker"],"properties":{"id":{"type":"string","minLength":1},"argv":{"type":"array","minItems":2,"items":{"type":"string"}},"marker":{"type":"string","minLength":1},"timeout_seconds":{"type":"integer","minimum":1,"maximum":300}}}}
}
