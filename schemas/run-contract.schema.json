{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunContract",
  "description": "Especificación formal del contrato aprobado para una ejecución autónoma del Desarrollador Autónomo",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "project_root",
    "objective",
    "acceptance_criteria",
    "autonomy_mode",
    "authorized",
    "created_at",
    "time_budget_minutes",
    "allowed_actions",
    "forbidden_actions",
    "security_policy_reference"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-zA-Z0-9_-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 5
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "autonomy_mode": {
      "type": "string",
      "enum": ["unattended", "interactive", "supervised"]
    },
    "authorized": {
      "type": "boolean"
    },
    "authorized_at": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string"
    },
    "time_budget_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "allowed_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbidden_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "build_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "security_policy_reference": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
