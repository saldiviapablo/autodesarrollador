# ==============================================================================
# .gitignore — Desarrollador Autónomo
# ==============================================================================

# Backups locales (los backups se preservan en disco pero no se versionan en Git)
backups/

# Logs del sistema y de ejecución
logs/
*.log
*.log.*

# Archivos de entorno y posibles secretos
.env
.env.*
*.secret
*.key
*.pem
*.token
.netrc
_netrc
.npmrc
.pypirc
id_rsa
id_ed25519
*.p12
*.pfx
*.jks
*.kdbx
credentials.json
token.json
cookies*.json

# Python & entornos virtuales
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos de sistema operativo y editores
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Artefactos temporales de ejecución autónoma
.autopilot/LOCK.json
.autopilot/HEARTBEAT.json
.autopilot/logs/
.autopilot/checkpoints/
.qwen/
sandbox/
runtime/
data/

# Publicación: modelos, perfiles/sesiones y temporales siempre locales.
*.gguf
*.ggml
.cache/
Cookies
Login Data
Web Data
Local State
Session Storage/
Sessions/
*.tmp
*.temp
*.bak

# Exclusiones explícitas adicionales para la revisión de publicación.
/runtime/project-launcher/planner-sources/
/runtime/project-launcher/planner-results/
/data/browser/HERMES-CHATGPT/

# Política de Evidence:
# Se versionan reportes, transcripciones y evidencias en formato texto (.md, .json, .txt).
# Se excluyen volcados binarios pesados o volcados masivos de memoria/red.
evidence/**/*.bin
evidence/**/*.zip
evidence/**/*.tar*
evidence/**/*.dmp
