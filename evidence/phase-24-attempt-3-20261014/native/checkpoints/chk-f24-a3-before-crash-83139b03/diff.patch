diff --git a/README.md b/README.md index 6b861ce..219cbb8 100644 --- a/README.md +++ b/README.md @@ -1,2 +1,60 @@  # Invoice sandbox -TODO document precise rounding and allocations. + +## Precise monetary rounding — `cents(value)` + +`cents(value)` converts any numeric value to a **two-decimal string** using Python's +`decimal.Decimal` with the **`ROUND_HALF_UP`** rounding mode. + +```python +>>> cents("2.675") +'2.68' +>>> cents("0") +'0.00' +``` + +Invalid, non-finite or non-numeric inputs (NaN, Infinity, arbitrary strings) raise +`ValueError`. + +> **Reference:** https://docs.python.org/3/library/decimal.html + +## Invoice totals — `total(lines)` + +`total(lines)` computes the sum of `price × quantity` pairs without rounding +individual line items, then rounds the final sum to two decimals with +`ROUND_HALF_UP`. + +```python +>>> total([("2.675", 2), ("1.00", 3)]) +'8.35' +>>> total([]) +'0.00' +``` + +## Cent-conserving allocation — `allocate(value, weights)` + +`allocate(value, weights)` distributes a non-negative *amount* across +positive or zero *weights* using the **largest remainder method** +(Hare / Sainte-Laguë) in integer cents. + +* **`value`** — a non-negative amount (e.g. `"1.00"`). Must be >= 0. +* **`weights`** — a non-empty list of non-negative numbers. Individual zero +  weights are allowed (they receive `"0.00"`). Total weight must be positive. + +The function returns a list of two-decimal strings whose sum is **exactly** +the rounded input value (cent conservation). Ties in the remainder bucket +are broken by **earlier input index**. + +```python +>>> allocate("0.05", [1, 1, 1]) +['0.02', '0.02', '0.01'] +>>> allocate("1.00", [1, 2, 3]) +['0.17', '0.33', '0.50'] +>>> allocate("1.00", [0, 1]) +['0.00', '1.00'] +``` + +Invalid inputs (negative amount, negative weight, zero total weight, +non-numeric values) raise `ValueError`. + +> **Reference:** Largest remainder method — fair apportionment algorithm that +> guarantees integer totals sum exactly to the rounded value. diff --git a/invoice.py b/invoice.py index 9f2d856..0b269fa 100644 --- a/invoice.py +++ b/invoice.py @@ -1,8 +1,109 @@ +from decimal import Decimal, ROUND_HALF_UP, InvalidOperation + +  def cents(value): -    return str(round(float(value),2)) +    """Convert *value* to a two-decimal string using ROUND_HALF_UP. + +    ``value`` may be a string, int, float or Decimal.  NaN, Infinity and +    non-numeric strings raise ``ValueError``. +    """ +    if isinstance(value, float): +        if not (value == value and value != float("inf") and value != float("-inf")): +            raise ValueError(f"non-finite float: {value!r}") + +    try: +        d = Decimal(str(value)) +    except (InvalidOperation, TypeError): +        raise ValueError(f"invalid monetary value: {value!r}") + +    if not d.is_finite(): +        raise ValueError(f"non-finite Decimal: {d}") + +    return str(d.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)) +    def total(lines): -    raise NotImplementedError("missing invoice feature") +    """Return the cent-precise total of *(price, quantity)* pairs. + +    *price* is interpreted via :func:`cents`; *quantity* is multiplied as a +    raw Decimal (no rounding on individual line items).  The final sum is +    rounded to two decimals with ROUND_HALF_UP. +    """ +    acc = Decimal("0") +    for price, qty in lines: +        acc += Decimal(str(price)) * Decimal(str(qty)) +    return str(acc.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)) + + +def allocate(value, weights): +    """Split *value* (a two-decimal string) across *weights* via largest +    remainder (Hare / Sainte-Laguë style integer-cent allocation). + +    Returns a list of two-decimal strings that sum *exactly* to the +    rounded input value. + +    Validation +    ---------- +    * *value* must be non-negative. +    * Every weight must be a non-negative number; total weight must be +      positive.  Zero weights are allowed (they receive ``"0.00"``). +    * Non-numeric or non-finite inputs raise ``ValueError``. +    """ +    # ---- validate & normalise amount ---- +    try: +        amount = Decimal(str(value)) +    except (InvalidOperation, TypeError): +        raise ValueError(f"invalid amount: {value!r}") +    if not amount.is_finite() or amount < 0: +        raise ValueError(f"amount must be non-negative: {value!r}") + +    amount_cents = int(amount.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP) * 100) + +    # ---- validate & normalise weights ---- +    try: +        weights = [int(w) for w in weights] +    except (TypeError, ValueError): +        raise ValueError(f"all weights must be numeric: {weights!r}") + +    if len(weights) == 0: +        raise ValueError("weights list must not be empty") +    if any(w < 0 for w in weights): +        raise ValueError(f"all weights must be non-negative: {weights!r}") +    total_weight = sum(weights) +    if total_weight == 0: +        raise ValueError("total weight must be positive") + +    # ---- largest remainder (integer cents) ---- +    # Each share gets (amount_cents * w) // total_weight cents. +    # Then distribute the remaining cents one-by-one to weights with the +    # largest fractional parts (ties broken by earlier index). +    shares_cents = [] +    for w in weights: +        shares_cents.append((amount_cents * w) // total_weight) + +    remainder = amount_cents - sum(shares_cents) + +    # We need to distribute *remainder* extra cents.  The fractional part +    # of share *i* is ((amount_cents * w) % total_weight).  Sort by +    # descending fractional remainder, break ties by ascending index. +    indices = sorted(range(len(weights)), +                     key=lambda i: ( +                         -((amount_cents * weights[i]) % total_weight), i)) + +    # Debug +    import sys +    print(f"DEBUG: amount_cents={amount_cents}, total_weight={total_weight}", file=sys.stderr) +    print(f"DEBUG: weights={weights}", file=sys.stderr) +    print(f"DEBUG: shares_cents before allocation={shares_cents}", file=sys.stderr) +    print(f"DEBUG: remainder={remainder}", file=sys.stderr) +    print(f"DEBUG: indices={indices}", file=sys.stderr) +    for i in range(len(weights)): +        frac = (amount_cents * weights[i]) % total_weight +        print(f"DEBUG: share[{i}] frac={frac}", file=sys.stderr) + +    for j in range(remainder): +        shares_cents[indices[j]] += 1 + +    print(f"DEBUG: shares_cents after allocation={shares_cents}", file=sys.stderr)   -def allocate(value,weights): -    raise NotImplementedError("missing allocation feature") +    return [cents(Decimal(c) / 100) for c in shares_cents]