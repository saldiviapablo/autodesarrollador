diff --git a/README.md b/README.md index 6b861ce..385a38b 100644 --- a/README.md +++ b/README.md @@ -1,2 +1,72 @@  # Invoice sandbox -TODO document precise rounding and allocations. + +Precise invoice arithmetic using Python's ``decimal`` module with +``ROUND_HALF_UP`` rounding to two decimal places. + +## Functions + +### ``cents(value)`` + +Converts *value* to a two-decimal string using +``ROUND_HALF_UP``.  Rejects ``NaN``, ``Infinity``, and any +non-numeric input with ``ValueError``. + +```python +>>> from invoice import cents +>>> cents("2.675") +'2.68' +>>> cents("-2.675") +'-2.68' +>>> cents("NaN") +ValueError: bad monetary value: 'NaN' +``` + +### ``total(lines)`` + +Sums ``price × quantity`` pairs and returns the grand total as a +cent-level string.  No intermediate rounding is applied; the sum is +rounded exactly once. + +```python +>>> from invoice import total +>>> total([("2.675", 2), ("1.00", 3)]) +'8.35' +>>> total([]) +'0.00' +``` + +### ``allocate(value, weights)`` + +Splits a non-negative *amount* across a sequence of non-negative +*weights* using the **largest remainder method** (Hare–Niemeyer / +Jefferson) in integer cents.  Ties (identical fractional parts) are +broken by earlier input index. + +- **amount** must be non-negative (>= 0). +- **weights** must contain at least one entry; zero-weight shares are +  allowed and receive ``"0.00"``. +- The returned list of two-decimal strings sums exactly to the +  rounded amount. + +```python +>>> from invoice import allocate +>>> allocate("0.05", [1, 1, 1]) +['0.02', '0.02', '0.01'] +>>> allocate("1.00", [1, 2, 3]) +['0.17', '0.33', '0.50'] +>>> allocate("1.00", [0, 1]) +['0.00', '1.00'] +``` + +Raises ``ValueError`` for negative amounts, negative weights, empty +weight lists, or when all weights are zero. + +## Why ``Decimal`` with ``ROUND_HALF_UP`` + +Binary ``float`` cannot represent values like 1.1 or 2.675 exactly; +rounding 2.675 with ``round()`` gives ``2.67`` (banker's rounding). +The ``decimal`` module provides exact decimal representation and a +configurable ``ROUND_HALF_UP`` rounding mode — the standard for +accounting and monetary calculations — where 2.675 rounds to 2.68. + +Reference: https://docs.python.org/3/library/decimal.html diff --git a/invoice.py b/invoice.py index 9f2d856..263f18f 100644 --- a/invoice.py +++ b/invoice.py @@ -1,8 +1,113 @@ +from decimal import Decimal, ROUND_HALF_UP, InvalidOperation + +  def cents(value): -    return str(round(float(value),2)) +    """Round *value* to two decimal places using ROUND_HALF_UP. + +    Accepts anything that can be turned into a string-safe Decimal, +    rejects NaN / Infinity / non-numeric strings with ValueError. +    """ +    if not isinstance(value, (str, Decimal, int, float)): +        raise ValueError(f"bad monetary value: {value!r}") + +    s = str(value).strip() +    try: +        d = Decimal(s) +    except InvalidOperation: +        raise ValueError(f"bad monetary value: {value!r}") + +    if not d.is_finite(): +        raise ValueError(f"bad monetary value: {value!r}") + +    return str(d.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)) +    def total(lines): -    raise NotImplementedError("missing invoice feature") +    """Sum *price × quantity* pairs and return the total as a cents string. + +    *lines* — iterable of ``(price, quantity)`` where each element accepts +    conversion via :func:`cents`.  No intermediate rounding is applied; +    the sum is rounded only once at the end. +    """ +    acc = Decimal("0") +    for price, quantity in lines: +        acc += Decimal(str(price)) * Decimal(str(quantity)) +    return str(acc.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)) + + +def allocate(value, weights): +    """Split *value* across *weights* using the largest-remainder method. + +    Parameters +    ---------- +    value : str | Decimal | int | float +        The total amount to distribute.  Must be non-negative. +    weights : sequence of numbers +        Positive or zero weights.  Zero-weight shares receive nothing. + +    Returns +    ------- +    list[str] +        One two-decimal string per weight; the list sums exactly to the +        rounded *value*. + +    Raises +    ------ +    ValueError +        If *value* is negative or malformed, or if *weights* is empty, +        contains negatives, contains non-numeric entries, or sums to +        zero when at least one element is provided. +    """ +    # --- validate value --- +    try: +        amount = Decimal(str(value).strip()) +    except (InvalidOperation, TypeError, ValueError): +        raise ValueError(f"bad allocation amount: {value!r}") +    if not amount.is_finite(): +        raise ValueError(f"bad allocation amount: {value!r}") +    if amount < 0: +        raise ValueError("amount must be nonnegative") + +    # --- validate weights --- +    if not weights: +        raise ValueError("weights must not be empty") + +    parsed = [] +    for w in weights: +        try: +            pw = Decimal(str(w)) +        except (InvalidOperation, TypeError, ValueError): +            raise ValueError(f"bad weight: {w!r}") +        if pw < 0: +            raise ValueError(f"weight must be nonnegative, got {w!r}") +        parsed.append(pw) + +    total_weight = sum(parsed) +    if total_weight == 0: +        raise ValueError("total weight must be > 0") + +    # --- largest-cent allocation --- +    cent = Decimal("0.01") +    total_cents = int((amount * 100).to_integral_value(rounding=ROUND_HALF_UP)) + +    # floor cents per share +    floor_cents = [int((w * total_cents) / total_weight) for w in parsed] +    remainder = total_cents - sum(floor_cents)  # >= 0 by construction + +    # fractional parts for tie-breaking (largest first, earliest index first) +    frac = [] +    for i, (w, fc) in enumerate(zip(parsed, floor_cents)): +        if w == 0: +            frac.append((Decimal("-1"), i))  # zero-weight gets no bump +        else: +            exact = (w * total_cents) / total_weight +            frac.append((exact - Decimal(fc), i)) + +    # sort by fractional part descending, break ties by index ascending +    indices = sorted(range(len(parsed)), key=lambda i: (frac[i][0], -frac[i][1]), reverse=True) + +    result = list(floor_cents) +    for i in indices[:remainder]: +        result[i] += 1  # give one extra cent   -def allocate(value,weights): -    raise NotImplementedError("missing allocation feature") +    return [str(Decimal(c) * cent) for c in result]