diff --git a/README.md b/README.md index 8f7b51b..9f5f055 100644 --- a/README.md +++ b/README.md @@ -1,3 +1,100 @@  # csv-ledger   -Documentation incomplete. +Normalize CSV ledger rows and aggregate exact decimal amounts. + +## API + +### `parse_ledger(text: str) -> list[dict]` + +Parse a CSV string with the exact header `date,category,amount`. + +- **Header validation**: The first row must be exactly `date,category,amount`. Any deviation raises `ValueError`. +- **Date validation**: Strict ISO YYYY-MM-DD format. Dates are validated against the Gregorian calendar (e.g., `2023-02-29` is invalid because 2023 is not a leap year; `2024-1-01` raises `ValueError` for noncanonical format). +- **Category**: Stripped of whitespace; blank categories raise `ValueError`. +- **Amount**: Parsed as `Decimal(str(x))` and quantized to two decimal places using `ROUND_HALF_UP`. Nonfinite values (`NaN`, `Infinity`) and malformed strings raise `ValueError`. +- **Row width**: Each row must have exactly 3 fields. Extra or missing fields raise `ValueError`. +- **Blank input**: Raises `ValueError`. +- **Header-only input**: Returns an empty list `[]`. +- **Unicode**: Preserved through CSV parsing and output. + +Example: + +```python +from module import parse_ledger + +rows = parse_ledger( +    "date,category,amount\n" +    "2024-02-29, Café ,1.005\n" +    '2024-03-01,"Comida, casa",-2.675\n' +) +# Returns: +# [ +#   {"date": "2024-02-29", "category": "Café", "amount": "1.01"}, +#   {"date": "2024-03-01", "category": "Comida, casa", "amount": "-2.68"} +# ] +``` + +### `totals(rows: list[dict]) -> dict[str, str]` + +Aggregate parsed rows by category using `Decimal` arithmetic. + +- Returns a dictionary with keys sorted **lexicographically**. +- Values are two-decimal strings (quantized with `ROUND_HALF_UP`). +- Negative amounts are allowed and aggregated correctly. + +Example: + +```python +from module import totals + +result = totals([ +    {"date": "2024-01-01", "category": "Z", "amount": "0.10"}, +    {"date": "2024-01-01", "category": "A", "amount": "0.20"}, +    {"date": "2024-01-02", "category": "Z", "amount": "0.20"}, +]) +# Returns: {"A": "0.20", "Z": "0.30"} +``` + +## CLI + +```bash +echo "date,category,amount +2024-01-01,Ñ,1.005" | python module.py +``` + +Output (JSON): + +```json +{"rows": [{"date": "2024-01-01", "category": "Ñ", "amount": "1.01"}], "totals": {"Ñ": "1.01"}} +``` + +- **Success**: Exit code `0`, JSON to `stdout` with `ensure_ascii=False`. +- **Error**: Exit code `2`, concise error message to `stderr` (no traceback). + +## Decimal Rounding + +All amounts use Python's `decimal.Decimal` with `ROUND_HALF_UP` to two decimal places: + +| Input  | Output | +|--------|--------| +| 1.005  | 1.01   | +| 2.675  | 2.68   | +| -2.675 | -2.68  | + +This follows the IEEE 754 standard for commercial rounding, avoiding binary floating-point artifacts. + +## Validation Errors + +The following inputs raise `ValueError`: + +- Blank or whitespace-only input +- Wrong header (e.g., `wrong,header`) +- Invalid dates (e.g., `2023-02-29`, `2024-1-01`) +- Empty categories +- Nonfinite amounts (`NaN`, `Infinity`) +- Malformed amounts (e.g., `bad`, non-numeric strings) +- Row width mismatch (too few or too many fields) + +## Unicode + +All Unicode characters are preserved throughout parsing and output. Category names, dates, and amounts support full Unicode (e.g., `Ñ`, ` café `, emojis if present in CSV fields). diff --git a/module.py b/module.py index 51704d3..327bf3f 100644 --- a/module.py +++ b/module.py @@ -1,6 +1,109 @@ -"""Incomplete csv-ledger utility. Worker must implement approved API.""" -def parse_ledger(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +"""CSV ledger normalizer and aggregator with exact Decimal arithmetic."""   -def totals(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +import csv +import io +import json +import sys +from decimal import Decimal, ROUND_HALF_UP, InvalidOperation +from datetime import date + + +def parse_ledger(text: str) -> list[dict]: +    """Parse a CSV string into a list of ledger dicts. + +    Header must be exactly ``date,category,amount``. +    Dates are validated as ISO YYYY-MM-DD using :class:`datetime.date`. +    Amounts are quantized to two decimals with ``Decimal(str(x)) ROUND_HALF_UP``. +    Categories are stripped (must be nonempty). +    Blank input raises ``ValueError``. +    """ +    if not text or not text.strip(): +        raise ValueError("blank input") + +    reader = csv.reader(io.StringIO(text)) +    rows_raw = list(reader) + +    if not rows_raw: +        raise ValueError("empty csv") + +    header = [h.strip() for h in rows_raw[0]] +    if header != ["date", "category", "amount"]: +        raise ValueError("invalid header") + +    if len(rows_raw) == 1: +        return [] + +    result: list[dict] = [] +    for row in rows_raw[1:]: +        if len(row) != 3: +            raise ValueError(f"row width mismatch: expected 3, got {len(row)}") + +        date_str, category_str, amount_str = row + +        # Validate date — must be YYYY-MM-DD and parse to a valid ISO calendar date +        date_stripped = date_str.strip() +        if len(date_stripped) != 10 or date_stripped[4] != '-' or date_stripped[7] != '-': +            raise ValueError(f"invalid date format: {date_str!r}") +        try: +            parsed_date = date( +                int(date_stripped[0:4]), +                int(date_stripped[5:7]), +                int(date_stripped[8:10]) +            ) +            # Verify roundtrip to catch formats like 2024-1-01 +            if parsed_date.isoformat() != date_stripped: +                raise ValueError(f"noncanonical date: {date_str!r}") +        except (ValueError, OverflowError) as exc: +            raise ValueError(f"invalid date: {date_str!r}") from exc + +        # Category: strip, reject empty +        category = category_str.strip() +        if not category: +            raise ValueError("empty category") + +        # Amount: quantize to 2 decimals with ROUND_HALF_UP +        amount_raw = amount_str.strip() +        try: +            amount_dec = Decimal(amount_raw) +        except (InvalidOperation, ValueError) as exc: +            raise ValueError(f"malformed amount: {amount_raw!r}") from exc + +        if not amount_dec.is_finite(): +            raise ValueError(f"nonfinite amount: {amount_raw!r}") + +        amount_quantized = amount_dec.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP) + +        result.append({ +            "date": parsed_date.isoformat(), +            "category": category, +            "amount": str(amount_quantized), +        }) + +    return result + + +def totals(rows: list[dict]) -> dict[str, str]: +    """Aggregate *rows* (output of :func:`parse_ledger`) by category. + +    Returns a ``dict`` with keys sorted lexicographically and values as +    two-decimal strings.  Negative amounts are allowed. +    """ +    agg: dict[str, Decimal] = {} +    for row in rows: +        cat = row["category"] +        amt = Decimal(row["amount"]) +        agg[cat] = agg.get(cat, Decimal("0")) + amt + +    return {k: str(v.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)) for k, v in sorted(agg.items())} + + +if __name__ == "__main__": +    import sys +    try: +        data = sys.stdin.read() +        rows = parse_ledger(data) +        out = {"rows": rows, "totals": totals(rows)} +        print(json.dumps(out, ensure_ascii=False)) +    except Exception as exc: +        print(f"error: {exc}", file=sys.stderr) +        sys.exit(2)