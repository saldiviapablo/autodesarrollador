diff --git a/README.md b/README.md index cf21d06..a128653 100644 --- a/README.md +++ b/README.md @@ -1,3 +1,118 @@  # intervals   -Documentation incomplete. +Merge integer time intervals, compute uncovered gaps, and measure peak concurrency. + +## API + +### `merge_intervals(intervals) -> list[tuple[int, int]]` + +Accepts a list of `[start, end]` pairs and returns a sorted list of **merged** +tuples.  Overlapping intervals **and** touching intervals (e.g. `[1,3)` and +`[3,5)`) are merged into a single continuous interval.  The input list is **not +mutated**. + +**Example** + +```python +>>> merge_intervals([[5, 8], [1, 3], [3, 5], [10, 12]]) +[(1, 8), (10, 12)] +``` + +### `gaps(intervals, start, end) -> list[tuple[int, int]]` + +Returns the sorted list of **uncovered** sub-intervals inside the window +`[start, end)`.  Every interval in *intervals* must lie completely within the +window. + +**Example** + +```python +>>> gaps([[2, 4], [4, 6], [8, 9]], 0, 10) +[(0, 2), (6, 8), (9, 10)] +``` + +### `peak_load(intervals) -> int` + +Returns the **maximum number of simultaneously active** half-open intervals. +Touching endpoints do **not** overlap because intervals are half-open +`[start, end)`.  An empty list returns `0`. + +**Example** + +```python +>>> peak_load([[0, 4], [1, 3], [2, 5]]) +3 +>>> peak_load([[0, 2], [2, 4]])  # touching, not overlapping +1 +``` + +## Input validation — `ValueError` + +All three functions validate their inputs and raise `ValueError` (exit code 2 +via the CLI) when: + +- `intervals` is not a list, or contains elements that are not two-element +  lists/tuples. +- Interval values are not plain `int` (``bool`` is rejected even though +  `bool` is a subclass of `int` in Python). +- `start >= end` or `start < 0`. +- For `gaps()`: an interval lies outside the requested `[start, end)` window, +  or `start/end` themselves are invalid. + +## CLI usage + +`module.py` reads JSON from **stdin** and writes a JSON object to **stdout**. + +```bash +echo '{"intervals":[[1,3],[3,5]],"start":0,"end":6}' | python module.py +``` + +**Output** + +```json +{ +  "merged": [[1, 5]], +  "gaps": [[0, 1], [5, 6]], +  "peak": 1 +} +``` + +Invalid input (malformed JSON, missing keys, bad values) produces a concise +error message on **stderr** and exits with code **2**. + +## Half-open / touching semantics + +All intervals are treated as **half-open** `[start, end)`: + +| Aspect | Rule | +|--------|------| +| Membership | `t` belongs to `[a, b)` iff `a <= t < b` | +| Overlap | `[1,3)` and `[3,5)` → **no** overlap (3 is excluded from the first) | +| `merge_intervals` | Touching intervals **are** merged because they form a continuous span | +| `peak_load` | Touching intervals count as **concurrent = 1** (the end of one coincides with the start of the next, but they do not overlap) | +| `gaps` | The window is `[start, end)`; uncovered regions are reported as tuples | + +### Worked example + +``` +Intervals:  [1,4), [3,6), [5,8) +Merged:     [1,8)                ← all three overlap at some point +Gaps [0,10): [(0,1), (8,10)]    ← nothing covers [0,1) or [8,10) +Peak:       3                    ← at t=5 both [3,6) and [5,8) are active (plus [1,4) ended at 4) +``` + +## Running tests and build + +```bash +python test_module.py +python build.py +``` + +Both must exit with code 0. + +## Constraints + +- Python standard library only (no third-party dependencies). +- UTF-8 encoding without BOM. +- No modification of `test_module.py`, `build.py`, `.autopilot/`, or any +  external files. diff --git a/module.py b/module.py index 818fb93..1c6dcda 100644 --- a/module.py +++ b/module.py @@ -1,9 +1,159 @@ -"""Incomplete intervals utility. Worker must implement approved API.""" -def merge_intervals(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +"""Merge integer time intervals, compute gaps and peak concurrency.   -def gaps(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +Semantics +--------- +All intervals are **half-open** `[start, end)`: they include *start* but +exclude *end*.  Touching intervals such as `[0,2)` and `[2,4)` do **not** +overlap and must **not** be merged by ``peak_load`` (they are merged by +``merge_intervals`` because they share an endpoint).   -def peak_load(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +Input validation +---------------- +* ``intervals`` must be a list of ``[start, end]`` pairs where +  ``0 <= start < end`` and both values are plain ``int`` (``bool`` is +  rejected). +* ``gaps(intervals, start, end)`` additionally requires +  ``0 <= start < end`` and every interval to lie completely inside +  ``[start, end)``. +* Violations raise ``ValueError`` with a short message on stderr. +""" +import json, sys +from pathlib import Path + + +def _validate_interval(pair): +    """Raise ValueError if *pair* is not a valid ``[int, int]``.""" +    if not isinstance(pair, (list, tuple)) or len(pair) != 2: +        raise ValueError("interval must be a two-element list") +    start, end = pair +    if isinstance(start, bool) or isinstance(end, bool): +        raise ValueError("bool values are not accepted") +    if not isinstance(start, int) or not isinstance(end, int): +        raise ValueError("interval values must be plain int") +    if start < 0 or start >= end: +        raise ValueError("must have 0 <= start < end") + + +def merge_intervals(intervals): +    """Return sorted list of merged tuples. + +    Overlapping and touching intervals are merged into a single interval. +    Input is **not** mutated. +    """ +    if not isinstance(intervals, list): +        raise ValueError("intervals must be a list") +    for pair in intervals: +        _validate_interval(pair) + +    if not intervals: +        return [] + +    # Work on a sorted copy of (start, end) tuples +    sorted_iv = sorted((pair[0], pair[1]) for pair in intervals) +    merged = [sorted_iv[0]] + +    for start, end in sorted_iv[1:]: +        last_start, last_end = merged[-1] +        if start <= last_end:  # overlap or touch +            merged[-1] = (last_start, max(last_end, end)) +        else: +            merged.append((start, end)) + +    return merged + + +def gaps(intervals, start, end): +    """Return sorted list of uncovered tuples inside ``[start, end)``. + +    Every interval in *intervals* must lie completely within ``[start, end)``. +    """ +    # Validate start/end +    if isinstance(start, bool) or isinstance(end, bool): +        raise ValueError("start/end must be plain int") +    if not isinstance(start, int) or not isinstance(end, int): +        raise ValueError("start/end must be plain int") +    if start < 0 or start >= end: +        raise ValueError("must have 0 <= start < end") + +    if not isinstance(intervals, list): +        raise ValueError("intervals must be a list") +    for pair in intervals: +        _validate_interval(pair) +        # Check interval is inside [start, end) +        if pair[0] < start or pair[1] > end: +            raise ValueError("interval must lie inside [start, end)") + +    # Merge intervals first +    merged = merge_intervals(intervals) + +    # Find uncovered regions +    result = [] +    current = start +    for s, e in merged: +        if current < s: +            result.append((current, s)) +        if e > current: +            current = e +    if current < end: +        result.append((current, end)) + +    return result + + +def peak_load(intervals): +    """Return maximum number of simultaneously active half-open intervals. + +    Touching endpoints do **not** overlap (half-open semantics). +    ``[]`` returns ``0``. +    """ +    if not isinstance(intervals, list): +        raise ValueError("intervals must be a list") +    for pair in intervals: +        _validate_interval(pair) + +    if not intervals: +        return 0 + +    events = [] +    for s, e in intervals: +        events.append((s, 1))   # interval starts +        events.append((e, -1))  # interval ends + +    events.sort(key=lambda x: (x[0], x[1])) + +    peak = current = 0 +    for _, delta in events: +        current += delta +        if current > peak: +            peak = current + +    return peak + + +# ── CLI ─────────────────────────────────────────────────────────────── +def _cli(): +    """Read JSON from stdin, print JSON result, exit 2 on invalid input.""" +    try: +        raw = sys.stdin.read() +        data = json.loads(raw) +        intervals = data["intervals"] +        start = data["start"] +        end = data["end"] + +        merged = merge_intervals(intervals) +        gap_list = gaps(intervals, start, end) +        pk = peak_load(intervals) + +        result = { +            "merged": [list(t) for t in merged], +            "gaps": [list(t) for t in gap_list], +            "peak": pk, +        } +        print(json.dumps(result)) +    except (json.JSONDecodeError, KeyError, TypeError, ValueError) as exc: +        print(str(exc), file=sys.stderr) +        sys.exit(2) + + +if __name__ == "__main__": +    _cli()