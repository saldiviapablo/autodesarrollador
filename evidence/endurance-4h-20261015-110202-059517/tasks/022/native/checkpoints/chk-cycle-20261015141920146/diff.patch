diff --git a/README.md b/README.md index 8f7b51b..a1a66ea 100644 --- a/README.md +++ b/README.md @@ -1,3 +1,72 @@  # csv-ledger   -Documentation incomplete. +Normalize CSV ledger rows and aggregate exact decimal amounts. + +## Installation + +``` +pip install -r requirements.txt +``` + +## Usage + +### API — `parse_ledger(text)` + +```python +from module import parse_ledger, totals + +rows = parse_ledger("date,category,amount\n2024-01-01,Café,1.005\n") +# → [{"date": "2024-01-01", "category": "Café", "amount": "1.01"}] +``` + +Reads a CSV string whose first row is the header `date,category,amount`.   +Returns a list of dicts preserving row order and Unicode content. + +**Validation rules** (all raise ``ValueError`` on violation): + +| Field    | Rules                                                                 | +|----------|-----------------------------------------------------------------------| +| **date** | Canonical ``YYYY-MM-DD``; real ISO proleptic Gregorian calendar date. | +| **category** | Nonempty after stripping whitespace.                              | +| **amount** | Parseable finite number; quantized to 2 decimal places.             | + +**Decimal rounding:** each amount is converted via ``Decimal(str(x))`` and quantized with ``ROUND_HALF_UP`` to two decimal digits. This is the standard "round half up" taught in schools (0.125 → 0.13, 2.675 → 2.68). + +**Edge cases:** + +- Blank input → ``ValueError``. +- Header-only (no data rows) → ``[]``. +- Invalid dates (e.g. ``2023-02-29``, ``2024-1-01``) → ``ValueError``. +- Nonfinite amounts (``NaN``, ``Infinity``) → ``ValueError``. +- Row width mismatch → ``ValueError``. + +### API — `totals(rows)` + +```python +from module import parse_ledger, totals + +rows = parse_ledger("date,category,amount\n2024-01-01,Z,0.10\n2024-01-01,A,0.20\n") +agg = totals(rows) +# → {"A": "0.20", "Z": "0.10"} +``` + +Aggregates the output of ``parse_ledger`` by category using ``Decimal`` arithmetic.   +Returns a ``dict`` keyed in lexicographic category order with values as two-decimal strings. + +### CLI + +```bash +# Valid input +echo -e "date,category,amount\n2024-01-01,Test,10.50" | python module.py +# → {"rows": [...], "totals": {"Test": "10.50"}} + +# Invalid input → exit code 2, concise error on stderr (no traceback) +echo "bad data" | python module.py +# → error message on stderr, exit code 2 +``` + +The CLI reads CSV from **stdin**, prints JSON (``ensure_ascii=False``) to **stdout**. + +## Requirements + +- Python 3.8+ (standard library only — ``csv``, ``decimal``, ``json``, ``datetime``). diff --git a/module.py b/module.py index 51704d3..4f673d4 100644 --- a/module.py +++ b/module.py @@ -1,6 +1,133 @@ -"""Incomplete csv-ledger utility. Worker must implement approved API.""" -def parse_ledger(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +"""CSV ledger: parse rows and aggregate totals with exact Decimal arithmetic."""   -def totals(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +import csv +import io +import json +import sys +from collections import OrderedDict +from datetime import date +from decimal import Decimal, ROUND_HALF_UP, InvalidOperation + +_EXPECTED_HEADER = ["date", "category", "amount"] + + +def parse_ledger(text): +    """Parse a CSV string with header *date,category,amount* and return a list of dicts. + +    Validation rules: +    - **Blank input** → ``ValueError``. +    - **Header mismatch** → ``ValueError``. +    - **Row width mismatch** → ``ValueError``. +    - **Date** must be canonical ``YYYY-MM-DD`` (digits/dashes only, no leading/trailing +      padding anomalies) and represent a real calendar date on the ISO proleptic +      Gregorian calendar. +    - **Category** must be nonempty after stripping whitespace. +    - **Amount** must parse as a finite number; the result is quantized to two +      decimal places using ``Decimal(str(x))`` with ``ROUND_HALF_UP``. + +    Preserves original row order and Unicode content. + +    A header-only document (no data rows) returns ``[]``. + +    Raises ``ValueError`` on any violation. +    """ +    if not text or not text.strip(): +        raise ValueError("blank input") + +    reader = csv.reader(io.StringIO(text)) +    rows_raw = list(reader) + +    if not rows_raw: +        raise ValueError("blank input") + +    header = [h.strip() for h in rows_raw[0]] +    if header != _EXPECTED_HEADER: +        raise ValueError( +            f"expected header {_EXPECTED_HEADER}, got {header}" +        ) + +    if len(rows_raw) == 1: +        return [] + +    result = [] +    for row in rows_raw[1:]: +        # Skip completely blank lines produced by trailing newline +        if len(row) == 0 or (len(row) == 1 and row[0].strip() == ""): +            continue + +        if len(row) != 3: +            raise ValueError(f"row width {len(row)}, expected 3") + +        raw_date, raw_category, raw_amount = row + +        # --- date --- +        d_str = raw_date.strip() +        # Must be exactly YYYY-MM-DD with 4-digit year, 2-digit month, 2-digit day +        if len(d_str) != 10 or d_str[4] != "-" or d_str[7] != "-": +            raise ValueError(f"invalid date format: {raw_date!r}") +        try: +            parsed = date.fromisoformat(d_str) +        except ValueError: +            raise ValueError(f"invalid date: {raw_date!r}") +        # Canonical round-trip: ensure the repr matches (rejects e.g. 2024-1-01) +        if parsed.isoformat() != d_str: +            raise ValueError(f"noncanonical date: {d_str!r}") + +        # --- category --- +        category = raw_category.strip() +        if not category: +            raise ValueError("empty category") + +        # --- amount --- +        amount_raw = raw_amount.strip() +        if not amount_raw: +            raise ValueError("empty amount") +        try: +            d_amount = Decimal(str(amount_raw)) +        except (InvalidOperation, ValueError): +            raise ValueError(f"malformed amount: {amount_raw!r}") +        if not d_amount.is_finite(): +            raise ValueError(f"nonfinite amount: {amount_raw!r}") +        amount_q = d_amount.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP) + +        result.append({ +            "date": d_str, +            "category": category, +            "amount": str(amount_q), +        }) + +    return result + + +def totals(rows): +    """Aggregate *rows* (output of :func:`parse_ledger`) by category. + +    Returns a ``dict`` keyed in lexicographic category order, values are +    two-decimal-place strings quantized with ``ROUND_HALF_UP``. +    """ +    acc = {} +    for row in rows: +        cat = row["category"] +        acc[cat] = acc.get(cat, Decimal("0.00")) + Decimal(row["amount"]) +    quantized = { +        k: str(v.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)) +        for k, v in sorted(acc.items()) +    } +    return quantized + + +def _cli(): +    """CLI entry-point: read CSV from stdin, print JSON to stdout.""" +    try: +        import sys +        text = sys.stdin.read() +        rows = parse_ledger(text) +        total = totals(rows) +        print(json.dumps({"rows": rows, "totals": total}, ensure_ascii=False, indent=2)) +    except ValueError as exc: +        print(str(exc), file=sys.stderr) +        sys.exit(2) + + +if __name__ == "__main__": +    _cli()