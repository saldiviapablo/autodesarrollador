                                                                                {
                                                                                    "type":  "user",
                                                                                    "uuid":  "72cab92e-aa77-4ada-af72-bb02459ebf07",
                                                                                    "session_id":  "34ab2239-e3d1-4630-8d43-ec5f0334653e",
                                                                                    "parent_tool_use_id":  null,
                                                                                    "message":  {
