                                                                                {
                                                                                    "type":  "user",
                                                                                    "uuid":  "d1e52775-b65d-4fe1-85e4-6531fbd095b3",
                                                                                    "session_id":  "34ab2239-e3d1-4630-8d43-ec5f0334653e",
