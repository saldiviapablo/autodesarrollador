diff --git a/README.md b/README.md index cf21d06..9f9f37b 100644 --- a/README.md +++ b/README.md @@ -1,3 +1,65 @@  # intervals   -Documentation incomplete. +Merge integer time intervals, compute gaps and peak concurrency. + +## API + +### `merge_intervals(intervals)` + +Merge overlapping and touching intervals. Returns a new sorted list of `(start, end)` tuples. + +- Intervals are **half-open** `[start, end)` — end is exclusive. +- Touching intervals (e.g. `[1,3)` and `[3,5)`) are merged into `[1,5)`. +- Does **not** mutate the input list. +- Raises `ValueError` on invalid input (non-int, bool, negative start, start >= end). + +```python +>>> merge_intervals([[5, 8], [1, 3], [3, 5], [10, 12]]) +[(1, 8), (10, 12)] +``` + +### `gaps(intervals, start, end)` + +Return sorted uncovered tuples within the window `[start, end)`. + +- `start`, `end` must be plain `int` with `0 <= start < end`. +- Every interval must lie completely inside the window. +- Raises `ValueError` on invalid input or out-of-range intervals. + +```python +>>> gaps([[2, 4], [4, 6], [8, 9]], 0, 10) +[(0, 2), (6, 8), (9, 10)] +``` + +### `peak_load(intervals)` + +Maximum number of concurrent half-open intervals. Touching endpoints do **not** overlap. Empty → `0`. + +```python +>>> peak_load([[0, 2], [2, 4]]) +1 +>>> peak_load([[0, 4], [1, 3], [2, 5]]) +3 +``` + +## CLI + +```bash +echo '{"intervals":[[1,3],[3,5]],"start":0,"end":6}' | python module.py +``` + +Output (JSON): + +```json +{"merged": [[1, 5]], "gaps": [[0, 1], [5, 6]], "peak": 1} +``` + +Invalid input → exit code `2` with concise error on stderr (no traceback). + +## Semantics + +- **Half-open intervals**: `[start, end)` includes `start`, excludes `end`. +- **Touching**: `[a,b)` and `[b,c)` touch at `b` but do not overlap. +  - `merge_intervals` merges them (contiguous). +  - `peak_load` counts them as non-overlapping (concurrency = 1 at the touch point). +- **Immutability**: `merge_intervals` and `gaps` return new lists; original input is never mutated. diff --git a/module.py b/module.py index 818fb93..f1f3d5d 100644 --- a/module.py +++ b/module.py @@ -1,9 +1,179 @@ -"""Incomplete intervals utility. Worker must implement approved API.""" -def merge_intervals(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +"""Merge integer time intervals, compute gaps and peak concurrency.   -def gaps(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +All public functions validate that inputs are plain ``int`` (not bool) and +raise ``ValueError`` with a concise one-line message on the first bad value +encountered.  ``merge_intervals`` and ``gaps`` return lists of ``(start, end)`` +tuples; ``peak_load`` returns a single ``int``.   -def peak_load(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +Semantics +--------- +* Intervals are **half-open** ``[start, end)`` — the end is exclusive. +* Two intervals ``[a, b)`` and ``[b, c)`` do **not** overlap (touching at a +  single point is fine).  ``merge_intervals`` merges them because "touching +  intervals" are considered contiguous and are collapsed into ``[a, c)``. +* ``peak_load`` counts concurrency on half-open intervals, so touching +  endpoints contribute 1, not 2. +""" +import json +import sys +from pathlib import Path + + +# ── helpers ──────────────────────────────────────────────────────────────── + +def _check_int(value, label: str = "value") -> None: +    """Raise ``ValueError`` when *value* is not a plain ``int`` (bool excluded).""" +    if isinstance(value, bool) or not isinstance(value, int): +        raise ValueError(f"{label} must be int, not {type(value).__name__}") + + +def _check_non_empty_list(items, label: str = "intervals") -> list: +    """Return *items* after validating it is a list of ``[start, end]`` pairs.""" +    if not isinstance(items, list): +        raise ValueError(f"{label} must be list") +    for i, iv in enumerate(items): +        if not isinstance(iv, (list, tuple)) or len(iv) != 2: +            raise ValueError(f"{label}[{i}] must be [start, end]") +        s, e = iv[0], iv[1] +        _check_int(s, f"{label}[{i}].start") +        _check_int(e, f"{label}[{i}].end") +        if s < 0: +            raise ValueError(f"{label}[{i}].start must be >= 0") +        if s >= e: +            raise ValueError(f"{label}[{i}]: start ({s}) >= end ({e})") +    return items + + +# ── public API ───────────────────────────────────────────────────────────── + +def merge_intervals(intervals: list) -> list: +    """Merge overlapping and touching integer intervals. + +    Returns a new list of ``(start, end)`` tuples sorted by start time. +    Does **not** mutate *intervals*. +    """ +    items = _check_non_empty_list(intervals, "intervals") +    if not items: +        return [] + +    sorted_ivs = sorted(items, key=lambda iv: (iv[0], iv[1])) +    merged = [tuple(sorted_ivs[0])] + +    for start, end in sorted_ivs[1:]: +        prev_start, prev_end = merged[-1] +        # Touching or overlapping → merge +        if start <= prev_end: +            merged[-1] = (prev_start, max(prev_end, end)) +        else: +            merged.append((start, end)) + +    return merged + + +def gaps(intervals: list, start: int, end: int) -> list: +    """Return sorted uncovered tuples within the window ``[start, end)``. + +    Validates that *start*, *end* are plain ``int`` with ``0 <= start < end``, +    and that every interval in *intervals* lies completely inside the window. +    """ +    _check_int(start, "start") +    _check_int(end, "end") +    if start < 0: +        raise ValueError("start must be >= 0") +    if start >= end: +        raise ValueError("start must be < end") + +    items = _check_non_empty_list(intervals, "intervals") + +    for i, iv in enumerate(items): +        if iv[0] < start or iv[1] > end: +            raise ValueError( +                f"intervals[{i}] ({iv[0]},{iv[1]}) outside window ({start},{end})" +            ) + +    merged = merge_intervals(intervals) +    result = [] +    cursor = start + +    for m_start, m_end in merged: +        if m_start > cursor: +            result.append((cursor, m_start)) +        cursor = max(cursor, m_end) + +    if cursor < end: +        result.append((cursor, end)) + +    return result + + +def peak_load(intervals: list) -> int: +    """Maximum number of concurrent half-open intervals. + +    Touching endpoints do **not** overlap.  Empty input → ``0``. +    """ +    items = _check_non_empty_list(intervals, "intervals") +    if not items: +        return 0 + +    events = [] +    for s, e in items: +        events.append((s, 1))   # interval starts +        events.append((e, -1))  # interval ends + +    events.sort(key=lambda x: (x[0], x[1])) + +    peak = current = 0 +    for _, delta in events: +        current += delta +        if current > peak: +            peak = current + +    return peak + + +# ── CLI ──────────────────────────────────────────────────────────────────── + +def _cli() -> int: +    """Read JSON from stdin, write JSON result to stdout. Exit 2 on error.""" +    try: +        raw = Path("/dev/stdin" if sys.platform == "win32" else "/dev/stdin").read_text(encoding="utf-8") +    except Exception: +        raw = sys.stdin.read() + +    try: +        data = json.loads(raw) +    except (json.JSONDecodeError, ValueError) as exc: +        print(f"Invalid JSON: {exc}", file=sys.stderr) +        return 2 + +    if not isinstance(data, dict): +        print("Input must be a JSON object", file=sys.stderr) +        return 2 + +    intervals = data.get("intervals") +    start = data.get("start") +    end = data.get("end") + +    if intervals is None or start is None or end is None: +        print("Missing keys: intervals, start, end", file=sys.stderr) +        return 2 + +    try: +        merged = merge_intervals(intervals) +        gap_list = gaps(intervals, start, end) +        peak = peak_load(intervals) +    except ValueError as exc: +        print(f"Validation error: {exc}", file=sys.stderr) +        return 2 + +    output = { +        "merged": [list(t) for t in merged], +        "gaps": [list(t) for t in gap_list], +        "peak": peak, +    } +    print(json.dumps(output)) +    return 0 + + +if __name__ == "__main__": +    raise SystemExit(_cli())