+
+def _validate_interval(pair) -> bool:
+    """Return True if *pair* is a valid [start, end) integer interval."""
+    if not isinstance(pair, (list, tuple)) or len(pair) != 2:
+        return False
+    start, end = pair
+    # Reject bools (bool is subclass of int)
+    if isinstance(start, bool) or isinstance(end, bool):
+        return False
+    if not isinstance(start, int) or not isinstance(end, int):
+        return False
+    if start < 0 or start >= end:
+        return False
+    return True
+
+
+def _validate_intervals_list(intervals):
+    """Validate that *intervals* is a list of valid [start, end) pairs."""
+    if not isinstance(intervals, list):
+        raise ValueError("intervals must be a list")
+    for pair in intervals:
+        if not _validate_interval(pair):
+            raise ValueError(f"invalid interval: {pair}")
+
+
+def merge_intervals(intervals: List[List[int]]) -> List[Tuple[int, int]]:
+    """Merge overlapping or touching integer intervals.
+
+    Returns a sorted list of merged (start, end) tuples.
+    Does NOT mutate the input list.
+    """
+    _validate_intervals_list(intervals)
+
+    if not intervals:
+        return []
+
+    # Work on a copy of sorted intervals
+    sorted_iv = sorted((tuple(iv) for iv in intervals), key=lambda x: (x[0], x[1]))
+    merged = [sorted_iv[0]]
+
+    for start, end in sorted_iv[1:]:
+        prev_start, prev_end = merged[-1]
+        # Overlapping or touching: start <= prev_end (merge touching intervals)
+        if start <= prev_end:
+            merged[-1] = (prev_start, max(prev_end, end))
+        else:
+            merged.append((start, end))
+
+    return merged
+
+
+def gaps(intervals: List[List[int]], start: int, end: int) -> List[Tuple[int, int]]:
+    """Return sorted uncovered intervals within [start, end).
+
+    Args:
+        intervals: list of valid [start, end) integer intervals.
+        start: integer (not bool), 0 <= start < end.
+        end: integer (not bool), start < end.
+
+    Every interval in *intervals* must lie within [start, end).
+
+    Returns sorted list of uncovered (a, b) tuples within the window.
+    """
+    # Validate start/end
+    if isinstance(start, bool) or isinstance(end, bool):
+        raise ValueError("start and end must be integers, not bool")
+    if not isinstance(start, int) or not isinstance(end, int):
+        raise ValueError("start and end must be integers")
+    if start < 0 or start >= end:
+        raise ValueError(f"invalid window: {start} < {end}")
+
+    _validate_intervals_list(intervals)
+
+    # Check all intervals lie within [start, end)
+    for pair in intervals:
+        s, e = pair
+        if s < start or e > end:
+            raise ValueError(
+                f"interval {pair} lies outside window [{start},{end})"
+            )
+
+    # Collect all interval endpoints within window, then find uncovered regions
+    events = []
+    for s, e in intervals:
+        events.append((s, 'S'))
+        events.append((e, 'E'))
+
+    events.sort(key=lambda x: (x[0], x[1]))
+
+    result = []
+    uncovered_start = start
+    active_count = 0
+
+    for pos, etype in events:
+        if etype == 'S':
+            if active_count == 0 and pos > uncovered_start:
+                result.append((uncovered_start, pos))
+            active_count += 1
+        else:  # 'E'
+            active_count -= 1
+            if active_count == 0:
+                uncovered_start = pos
+
+    # After all events, fill remaining gap up to end
+    if uncovered_start < end:
+        result.append((uncovered_start, end))
+
+    return result
+
+
+def peak_load(intervals: List[List[int]]) -> int:
+    """Compute maximum concurrent half-open intervals.
+
+    Touching endpoints do NOT overlap.  Empty input -> 0.
+    """
+    _validate_intervals_list(intervals)
+
+    if not intervals:
+        return 0
+
+    events = []
+    for s, e in intervals:
+        events.append((s, 1))   # interval starts
+        events.append((e, -1))  # interval ends
+
+    # Sort: by position, then ends (-1) before starts (1) at same position
+    # because half-open [s, e) means e is exclusive
+    events.sort(key=lambda x: (x[0], x[1]))
+
+    peak = 0
+    current = 0
+    for _, delta in events:
+        current += delta
+        peak = max(peak, current)
+
+    return peak
+
+
