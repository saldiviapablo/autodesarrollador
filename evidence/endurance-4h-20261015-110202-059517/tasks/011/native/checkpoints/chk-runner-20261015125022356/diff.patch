diff --git a/README.md b/README.md index cf21d06..c60a92a 100644 --- a/README.md +++ b/README.md @@ -1,3 +1,108 @@  # intervals   -Documentation incomplete. +Interval arithmetic for integer time ranges. Provides three core functions: + +- **`merge_intervals(intervals)`** — Merge overlapping and touching intervals. +- **`gaps(intervals, start, end)`** — Compute uncovered segments within a window. +- **`peak_load(intervals)`** — Maximum concurrent half-open intervals. + +## Semantics + +All functions use **half-open interval** semantics `[start, end)`: + +- The interval includes `start` but excludes `end`. +- Example: `[1, 3)` covers time points 1 and 2, but not 3. + +### Touching endpoints + +| Function | Behaviour | Example | +|---|---|---| +| `merge_intervals` | Touching intervals **merge** | `[1,2] + [2,3]` → `[(1,3)]` | +| `peak_load` | Touching endpoints **do not overlap** | `[1,2] + [2,3]` → peak = 1 | + +### Input validation + +- All interval endpoints must be **integers** (not `bool`, not float). +- Constraint: `0 <= start < end`. +- Invalid input raises **`ValueError`** with a concise message. +- CLI mode exits with **code 2** on validation errors. + +## API + +### `merge_intervals(intervals) -> List[Tuple[int, int]]` + +Merges overlapping and touching intervals. Returns sorted list of tuples. Does **not** mutate the input list. + +```python +>>> merge_intervals([[5, 8], [1, 3], [3, 5], [10, 12]]) +[(1, 8), (10, 12)] +>>> merge_intervals([]) +[] +``` + +### `gaps(intervals, start, end) -> List[Tuple[int, int]]` + +Computes uncovered segments within `[start, end)`. All intervals must lie inside the window. + +```python +>>> gaps([[2, 4], [4, 6], [8, 9]], 0, 10) +[(0, 2), (6, 8), (9, 10)] +>>> gaps([], 0, 3) +[(0, 3)] +>>> gaps([[0, 3]], 0, 3) +[] +``` + +### `peak_load(intervals) -> int` + +Maximum number of concurrent active intervals at any point. Uses half-open semantics — touching endpoints do not overlap. Returns 0 for empty input. + +```python +>>> peak_load([[0, 2], [2, 4]]) +1 +>>> peak_load([[0, 4], [1, 3], [2, 5]]) +3 +>>> peak_load([]) +0 +``` + +## CLI + +Run as a Python module. Reads JSON from `stdin`, writes JSON to `stdout`. + +**Input format:** +```json +{ +  "intervals": [[1, 3], [3, 5]], +  "start": 0, +  "end": 6 +} +``` + +**Output format:** +```json +{ +  "merged": [[1, 5]], +  "gaps": [[0, 1], [5, 6]], +  "peak": 1 +} +``` + +**Usage:** +```bash +python module.py +``` + +**Error handling:** Invalid JSON or validation errors produce a concise message on `stderr` and exit code **2**. No traceback is shown. + +## Requirements + +- Python 3.x (stdlib only). +- No external dependencies. + +## Running tests + +```bash +python test_module.py +python build.py +``` diff --git a/module.py b/module.py index 818fb93..73ef677 100644 --- a/module.py +++ b/module.py @@ -1,9 +1,200 @@ -"""Incomplete intervals utility. Worker must implement approved API.""" -def merge_intervals(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +"""Interval arithmetic: merge, gaps, peak concurrency.   -def gaps(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +All intervals use half-open semantics [start, end). +Touching endpoints merge in merge_intervals but do not overlap in peak_load. +"""   -def peak_load(*args,**kwargs): - raise NotImplementedError("incomplete baseline") +import json +import sys +from typing import List, Tuple + + +def _check_int(v, label: str = "value") -> None: +    """Raise ValueError if *v* is a bool or not an int.""" +    if isinstance(v, bool): +        raise ValueError(f"{label} must be int, not bool") +    if not isinstance(v, int): +        raise ValueError(f"{label} must be int") + + +def _check_non_negative_int(v, label: str = "value") -> None: +    """Raise ValueError if *v* is bool/non-int or < 0.""" +    _check_int(v, label) +    if v < 0: +        raise ValueError(f"{label} must be >= 0") + + +def _validate_pair(pair, index: int) -> Tuple[int, int]: +    """Validate a single [start, end] pair and return (start, end).""" +    if not isinstance(pair, (list, tuple)): +        raise ValueError(f"interval[{index}] must be a list/tuple") +    if len(pair) != 2: +        raise ValueError(f"interval[{index}] must have exactly 2 elements") +    start, end = pair +    _check_non_negative_int(start, f"interval[{index}].start") +    _check_non_negative_int(end, f"interval[{index}].end") +    if start >= end: +        raise ValueError( +            f"interval[{index}]: start ({start}) must be < end ({end})" +        ) +    return start, end + + +def merge_intervals(intervals: list) -> List[Tuple[int, int]]: +    """Merge overlapping and touching integer intervals. + +    Args: +        intervals: list of [start, end] pairs where 0 <= start < end. + +    Returns: +        Sorted list of merged tuples.  Does **not** mutate *intervals*. + +    Semantics: +        - Touching intervals merge: [1,2] + [2,3] -> [(1,3)]. +        - Overlapping intervals merge: [1,4] + [3,6] -> [(1,6)]. +    """ +    if not isinstance(intervals, (list, tuple)): +        raise ValueError("intervals must be a list") + +    parsed: List[Tuple[int, int]] = [] +    for i, iv in enumerate(intervals): +        parsed.append(_validate_pair(iv, i)) + +    if not parsed: +        return [] + +    parsed.sort() +    merged: List[Tuple[int, int]] = [parsed[0]] + +    for start, end in parsed[1:]: +        last_start, last_end = merged[-1] +        if start <= last_end: +            # Overlapping or touching -> merge +            merged[-1] = (last_start, max(last_end, end)) +        else: +            merged.append((start, end)) + +    return merged + + +def gaps(intervals: list, start: int, end: int) -> List[Tuple[int, int]]: +    """Compute uncovered segments in [start, end) given *intervals*. + +    Args: +        intervals: list of [start, end] pairs, all fully contained in +                   [global_start, global_end). +        start: window start (integer >= 0). +        end: window end (integer > start). + +    Returns: +        Sorted list of uncovered tuples within [start, end). + +    Raises: +        ValueError: on invalid inputs or if any interval falls outside +                    the [start, end) window. +    """ +    _check_non_negative_int(start, "start") +    _check_non_negative_int(end, "end") +    if start >= end: +        raise ValueError("start must be < end") + +    merged = merge_intervals(intervals) + +    # Verify every merged interval lies inside [start, end) +    for s, e in merged: +        if s < start or e > end: +            raise ValueError( +                f"interval ({s},{e}) outside window [{start},{end})" +            ) + +    # Collect uncovered segments within [start, end) +    result: List[Tuple[int, int]] = [] +    cursor = start + +    for s, e in merged: +        if s > cursor: +            result.append((cursor, s)) +        cursor = max(cursor, e) + +    if cursor < end: +        result.append((cursor, end)) + +    return result + + +def peak_load(intervals: list) -> int: +    """Maximum concurrent half-open intervals. + +    Args: +        intervals: list of [start, end] pairs where 0 <= start < end. + +    Returns: +        Integer peak concurrency.  Touching endpoints do **not** overlap. +        Returns 0 for empty input. + +    Semantics: +        - [1,2] and [2,3] overlap count = 1 (half-open). +        - [0,4],[1,3],[2,5] overlap count = 3. +    """ +    if not isinstance(intervals, (list, tuple)): +        raise ValueError("intervals must be a list") + +    if not intervals: +        return 0 + +    parsed: List[Tuple[int, int]] = [] +    for i, iv in enumerate(intervals): +        parsed.append(_validate_pair(iv, i)) + +    events: List[Tuple[int, int]] = [] +    for start, end in parsed: +        events.append((start, 1))   # interval starts +        events.append((end, -1))    # interval ends + +    # Sort by position; ends before starts at same position (half-open) +    events.sort(key=lambda x: (x[0], x[1])) + +    peak = 0 +    current = 0 +    for _, delta in events: +        current += delta +        peak = max(peak, current) + +    return peak + + +def _cli_main() -> None: +    """CLI entry-point: read JSON from stdin, write JSON to stdout.""" +    raw = sys.stdin.read() +    try: +        data = json.loads(raw) +    except json.JSONDecodeError: +        print("invalid JSON input", file=sys.stderr) +        sys.exit(2) + +    try: +        intervals = data["intervals"] +        start = data["start"] +        end = data["end"] +    except KeyError: +        print("missing required keys: intervals, start, end", file=sys.stderr) +        sys.exit(2) + +    try: +        merged = merge_intervals(intervals) +        gap_result = gaps(intervals, start, end) +        peak = peak_load(intervals) +    except ValueError as exc: +        print(str(exc), file=sys.stderr) +        sys.exit(2) + +    output = { +        "merged": [list(t) for t in merged], +        "gaps": [list(t) for t in gap_result], +        "peak": peak, +    } +    print(json.dumps(output)) + + +if __name__ == "__main__": +    _cli_main()